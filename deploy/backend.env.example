# Copy to /etc/parkick/backend.env on the EC2 host, then replace placeholders.
# Never commit the populated file. The initial deployment needs no S3 credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=https://parkick.example.com
TRUST_PROXY=loopback

# Production uses DB administrator accounts and sessions; development mocks stay disabled.
# Provision the first platform admin explicitly with deploy/create-platform-admin.ts.
ENABLE_DEV_ADMIN=false

# PostgreSQL on the same EC2 host, with a dedicated password-protected application role.
DATABASE_URL="postgresql://parkick_app:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@127.0.0.1:5432/parkick"
PHONE_ENCRYPTION_KEY="REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64"
PHONE_LOOKUP_HMAC_KEY="REPLACE_WITH_DIFFERENT_32_RANDOM_BYTES_IN_BASE64"

# Private photos on the EC2 EBS volume, outside the source tree and Nginx web root.
# Keep this directory together with PostgreSQL data and phone keys when backing up.
REPORT_STORAGE_PROVIDER=local
REPORT_STORAGE_DIR=/var/lib/parkick/reports

# S3 connection after SafeInstanceProfile-sgu-202686 is attached and verified on this EC2.
# Keep REPORT_STORAGE_DIR set when switching: existing local photos remain readable there.
# Existing photos are not automatically copied to S3. Credentials come from the EC2 role.
AWS_REGION=
S3_REPORT_BUCKET=
S3_REPORT_PREFIX=reports

# Initial deployment demonstration only: explicitly NOT an actual jurisdiction.
# Replace after real tenant/region onboarding is implemented and configured.
REPORT_REGION_CODE=local-development

# Use litellm for photo relevance after the private proxy settings are installed and
# validated on this host. Disabled still checks photo format; production mock is forbidden.
AI_PROVIDER=disabled
# HTTPS origin or /v1 API base. The backend appends /v1/chat/completions.
LLM_API_BASE_URL=
# Secret proxy key; set only in /etc/parkick/backend.env, never commit it.
LLM_API_KEY=
# Image-capable proxy alias, e.g. bedrock-haiku.
LLM_REPORT_MODEL_ID=
# Public chatbot uses the same HTTPS LiteLLM gateway through a separate server-side config.
# The deployed host may reuse its existing LLM_API_KEY; never put a key in this example.
CHATBOT_PROVIDER=disabled
CHATBOT_BASE_URL=
CHATBOT_API_KEY=
CHATBOT_MODEL=bedrock-haiku
CHATBOT_TIMEOUT_MS=20000
# Direct-Bedrock fallback only; unused when AI_PROVIDER=litellm.
BEDROCK_REGION=
BEDROCK_REPORT_MODEL_ID=
