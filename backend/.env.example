NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# EC2 Nginx on the same host: loopback. Direct local access: false.
TRUST_PROXY=false
# In development only, localhost and 127.0.0.1 are both allowed at this exact scheme/port.
FRONTEND_ORIGIN=http://localhost:5173

# MOCK: opt in locally. Set your own email and a password of at least 12 characters.
# This only creates a local mock account; these values are not deployed to EC2.
# Production keeps this false and uses separately provisioned DB accounts and sessions.
ENABLE_DEV_ADMIN=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=개발 관리자

# Phase 3: blank selects mock in development/test and disabled in production.
# mock is a deterministic development template; production explicitly rejects mock.
# bedrock requires Region + an accessible Converse model ID/inference profile ID.
# AWS authentication uses the standard SDK chain (local profile / deployment IAM role).
# After `aws login --profile parkick`, local development may set AWS_PROFILE=parkick.
AI_PROVIDER=
AWS_REGION=
# Optional AI-only region; blank falls back to AWS_REGION. S3 still uses AWS_REGION.
# Example: BEDROCK_REGION=us-east-1 with AWS_REGION=ap-northeast-2.
BEDROCK_REGION=
BEDROCK_REPORT_MODEL_ID=

# Phase 4 local intake. Run npm run setup:local from the repository root.
# The setup only fills blank DATABASE_URL and the two independent 32-byte base64 keys.
# Blank DATABASE_URL keeps submission disabled.
# Production local storage requires explicit REPORT_STORAGE_PROVIDER=local and
# an absolute private path, e.g. REPORT_STORAGE_DIR=/var/lib/parkick/reports.
DATABASE_URL=
PHONE_ENCRYPTION_KEY=
PHONE_LOOKUP_HMAC_KEY=
REPORT_STORAGE_DIR=./data/reports
REPORT_REGION_CODE=local-development

# local retains development disk storage; s3 uploads sanitized photos to the bucket.
# s3 requires DATABASE_URL + AWS_REGION + S3_REPORT_BUCKET and SDK credentials.
# EC2 uses an IAM role; local development can use AWS_PROFILE (no keys in frontend).
REPORT_STORAGE_PROVIDER=local
S3_REPORT_BUCKET=
S3_REPORT_PREFIX=reports
