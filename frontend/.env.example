# Development server proxy only. Never put private keys in VITE_ variables.
API_PROXY_TARGET=http://127.0.0.1:4000
# Optional same-origin API path. Deployment should reverse-proxy /api.
VITE_API_BASE_URL=/api
# NAVER Maps Client ID (public browser identifier; register allowed Web service URLs).
# In Maps > Application, select Web Dynamic Map and Reverse Geocoding.
# Register the exact site origin, including HTTPS, for browser address lookups.
# Do not put the Client Secret in this file or any VITE_ variable.
# Leave blank to use GPS / manual coordinates without loading the map SDK.
VITE_NAVER_MAP_CLIENT_ID=
